{
  "extends": "node3d",
  "node": {
    "icon": "grid-3x3",
    "leaf": true
  },
  "props": {
    "grid": {
      "label": "Grid"
    },
    "laid": {
      "label": "Laid"
    }
  },
  "layout": [
    {
      "section": "site",
      "title": "Site",
      "icon": "grid-3x3",
      "before": "appearance",
      "items": [
        {
          "row": [
            "width",
            "depth"
          ],
          "cells": "labelled",
          "columns": 2
        },
        "cell",
        "grid"
      ]
    },
    {
      "section": "startsAt",
      "title": "Starts at",
      "icon": "play",
      "collapsible": true,
      "collapsed": true,
      "items": [
        "laid"
      ]
    }
  ],
  "commands": {
    "lay": {
      "label": "Lay",
      "icon": "layers",
      "category": "transform",
      "description": "Raises the plate and rules its grid.",
      "defaults": {
        "duration": 2
      }
    }
  }
}
