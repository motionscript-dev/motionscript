{
  "extends": "node3d",
  "icon": "blocks",
  "leaf": true,
  "properties": {
    "kind": {
      "label": "Building",
      "control": "segmented",
      "options": [
        {
          "value": "house",
          "label": "House"
        },
        {
          "value": "block",
          "label": "Block"
        },
        {
          "value": "tower",
          "label": "Tower"
        }
      ]
    },
    "width": {
      "label": "Width"
    },
    "depth": {
      "label": "Depth"
    },
    "storeys": {
      "label": "Storeys",
      "control": "slider"
    },
    "storeyHeight": {
      "label": "Storey height"
    },
    "color": {
      "label": "Color"
    },
    "lineColor": {
      "label": "Lines"
    },
    "lineWidth": {
      "label": "Line weight",
      "control": "slider"
    },
    "openings": {
      "label": "Windows",
      "control": "switch"
    },
    "floorLines": {
      "label": "Floor lines",
      "control": "switch"
    },
    "hiddenLines": {
      "label": "Hidden lines",
      "control": "switch"
    },
    "dimensions": {
      "label": "Dimensions",
      "control": "switch"
    },
    "raised": {
      "label": "Raised",
      "control": "slider"
    },
    "measured": {
      "label": "Dimensions in",
      "control": "slider"
    },
    "labelSize": {
      "label": "Dimension size",
      "control": "slider"
    }
  },
  "commands": {
    "raise": {
      "label": "Raise",
      "icon": "arrow-up-to-line",
      "category": "transform",
      "description": "Builds it up from the ground one storey at a time, then its roof.",
      "defaults": {
        "duration": 2.4
      }
    },
    "measure": {
      "label": "Measure",
      "icon": "ruler",
      "category": "paint",
      "description": "Draws the dimensions in: they fade and slide out from the building.",
      "defaults": {
        "duration": 0.8
      }
    }
  },
  "layout": [
    {
      "section": "building",
      "title": "Building",
      "icon": "blocks",
      "before": "appearance",
      "items": [
        "kind",
        {
          "row": [
            "width",
            "depth"
          ],
          "cells": "labelled",
          "columns": 2
        },
        {
          "row": [
            "storeys",
            "storeyHeight"
          ],
          "cells": "labelled",
          "columns": 2
        }
      ]
    },
    {
      "section": "drawing",
      "title": "Drawing",
      "icon": "pen-tool",
      "before": "appearance",
      "items": [
        {
          "row": [
            "color",
            "lineColor"
          ],
          "cells": "labelled",
          "columns": 2
        },
        "lineWidth",
        "openings",
        "floorLines",
        "hiddenLines",
        "dimensions",
        "labelSize"
      ]
    },
    {
      "section": "buildingStart",
      "title": "Starts at",
      "icon": "play",
      "before": "appearance",
      "collapsible": true,
      "collapsed": true,
      "items": [
        "raised",
        "measured"
      ]
    }
  ]
}