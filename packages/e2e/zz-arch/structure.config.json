{
  "extends": "node3d",
  "icon": "grid-2x2",
  "leaf": true,
  "properties": {
    "kind": {
      "label": "Structure",
      "control": "segmented",
      "options": [
        {
          "value": "frame",
          "label": "Frame"
        },
        {
          "value": "truss",
          "label": "Truss"
        }
      ]
    },
    "baysX": {
      "label": "Bays across"
    },
    "baysZ": {
      "label": "Bays deep"
    },
    "storeys": {
      "label": "Storeys"
    },
    "panels": {
      "label": "Panels"
    },
    "bay": {
      "label": "Bay"
    },
    "storeyHeight": {
      "label": "Storey height"
    },
    "color": {
      "label": "Members"
    },
    "slabColor": {
      "label": "Slabs"
    },
    "braceColor": {
      "label": "Bracing"
    },
    "lineColor": {
      "label": "Lines"
    },
    "tensionColor": {
      "label": "Tension"
    },
    "compressionColor": {
      "label": "Compression"
    },
    "loadColor": {
      "label": "Load"
    },
    "lineWidth": {
      "label": "Line weight",
      "control": "slider"
    },
    "deflection": {
      "label": "Sag",
      "control": "slider"
    },
    "dimensions": {
      "label": "Dimensions",
      "control": "switch"
    },
    "erected": {
      "label": "Erected",
      "control": "slider"
    },
    "loaded": {
      "label": "Loaded",
      "control": "slider"
    },
    "measured": {
      "label": "Dimensions in",
      "control": "slider"
    },
    "labelSize": {
      "label": "Dimension size",
      "control": "slider"
    }
  },
  "commands": {
    "erect": {
      "label": "Erect",
      "icon": "grid-2x2",
      "category": "transform",
      "description": "Puts the structure up: a frame storey by storey, a truss chord, web and bracing.",
      "defaults": {
        "duration": 4
      }
    },
    "load": {
      "label": "Load",
      "icon": "arrow-down-to-line",
      "category": "paint",
      "description": "Brings the load down: members turn blue in tension and orange in compression, and the span sags.",
      "defaults": {
        "duration": 1.6
      }
    },
    "unload": {
      "label": "Unload",
      "icon": "arrow-up-to-line",
      "category": "paint",
      "description": "Takes the load off again.",
      "defaults": {
        "duration": 1
      }
    },
    "measure": {
      "label": "Measure",
      "icon": "ruler",
      "category": "paint",
      "description": "Draws the dimensions in.",
      "defaults": {
        "duration": 0.8
      }
    }
  },
  "layout": [
    {
      "section": "structure",
      "title": "Structure",
      "icon": "grid-2x2",
      "before": "appearance",
      "items": [
        "kind",
        {
          "row": [
            "baysX",
            "baysZ"
          ],
          "cells": "labelled",
          "columns": 2
        },
        {
          "row": [
            "storeys",
            "panels"
          ],
          "cells": "labelled",
          "columns": 2
        },
        {
          "row": [
            "bay",
            "storeyHeight"
          ],
          "cells": "labelled",
          "columns": 2
        }
      ]
    },
    {
      "section": "structureColors",
      "title": "Drawing",
      "icon": "pen-tool",
      "before": "appearance",
      "items": [
        {
          "row": [
            "color",
            "slabColor"
          ],
          "cells": "labelled",
          "columns": 2
        },
        {
          "row": [
            "braceColor",
            "lineColor"
          ],
          "cells": "labelled",
          "columns": 2
        },
        {
          "row": [
            "tensionColor",
            "compressionColor"
          ],
          "cells": "labelled",
          "columns": 2
        },
        "loadColor",
        "lineWidth",
        "deflection",
        "dimensions",
        "labelSize"
      ]
    },
    {
      "section": "structureStart",
      "title": "Starts at",
      "icon": "play",
      "before": "appearance",
      "collapsible": true,
      "collapsed": true,
      "items": [
        "erected",
        "loaded",
        "measured"
      ]
    }
  ]
}