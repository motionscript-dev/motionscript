{
  "name": "@motionscript/e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Visual end-to-end test harness: renders one scene per TESTS.md checkbox at 960x540/30fps, screenshots first/mid/last frames, and pixel-diffs a stable build against the live library build.",
  "author": "Motionscript",
  "type": "module",
  "scripts": {
    "gen": "tsx scripts/gen-scenes.ts",
    "screenshot": "tsx scripts/shoot.ts",
    "test:e2e": "tsx scripts/wgpu-lane.ts",
    "test:wgpu": "tsx scripts/wgpu-lane.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "rimraf out .turbo"
  },
  "dependencies": {
    "@motionscript/sdk": "workspace:*",
    "@motionscript/core": "workspace:^",
    "@motionscript/patterns": "workspace:^",
    "@motionscript/code": "workspace:^",
    "@motionscript/math": "workspace:^"
  },
  "devDependencies": {
    "@motionscript/headless": "workspace:*",
    "@motionscript/renderer": "workspace:*",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
