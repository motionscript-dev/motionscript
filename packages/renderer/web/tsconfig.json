{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@motionscript/core": [
        "../../core/dist/index.d.ts"
      ],
      "mediabunny": [
        "../../../node_modules/.pnpm/mediabunny@1.49.0/node_modules/mediabunny/dist/modules/src/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "pkg/*.d.ts"
  ]
}
