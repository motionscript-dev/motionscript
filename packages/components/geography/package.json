{
  "name": "@motionscript/geography",
  "version": "0.1.0-alpha.9",
  "type": "module",
  "description": "Geography for Motion Script: GeoBorder, and the country and state outlines it draws by ISO 3166 code, derived from Natural Earth (public domain).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motionscript-dev/motionscript.git",
    "directory": "packages/components/geography"
  },
  "homepage": "https://motionscript.dev",
  "bugs": {
    "url": "https://github.com/motionscript-dev/motionscript/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "NOTICE",
    "dist",
    "src",
    "registry.json",
    "CHANGELOG.md",
    "data",
    "CREDITS.md",
    "!dist/**/*.tsbuildinfo",
    "!src/**/tests/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.fixtures.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./data/*": "./data/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && node ../../../scripts/build-browser.mjs",
    "dev": "tsc -p tsconfig.build.json --watch & tsc-alias -p tsconfig.build.json --resolve-full-paths -w",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo",
    "test": "vitest run && node --test \"scripts/**/*.test.mjs\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node --max-old-space-size=8192 scripts/generate.mjs",
    "verify": "node scripts/verify.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "keywords": [
    "motion-script",
    "motion script",
    "geo",
    "animation",
    "iso-3166",
    "natural-earth"
  ],
  "license": "Apache-2.0",
  "author": "Motionscript",
  "peerDependencies": {
    "@motionscript/sdk": "workspace:^"
  },
  "devDependencies": {
    "@motionscript/core": "workspace:*",
    "@motionscript/sdk": "workspace:*",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "catalog:",
    "d3-geo-projection": "4.0.0",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "d3-geo": "^3.1.1"
  }
}
