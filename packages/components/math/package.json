{
  "name": "@motionscript/math",
  "version": "0.1.0",
  "type": "module",
  "description": "Math for Motion Script: coordinate systems, function and vector-field plots, 3D graphs and surfaces, network graphs, and LaTeX formulas typeset to glyph paths that morph token by token.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motionscript-dev/motionscript.git",
    "directory": "packages/components/math"
  },
  "homepage": "https://motionscript.dev",
  "bugs": {
    "url": "https://github.com/motionscript-dev/motionscript/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "NOTICE",
    "dist",
    "src",
    "registry.json",
    "CHANGELOG.md",
    "!dist/**/*.tsbuildinfo",
    "!src/**/tests/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.fixtures.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./tex": {
      "types": "./dist/tex/index.d.ts",
      "default": "./dist/tex/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && node ../../../scripts/build-browser.mjs",
    "dev": "tsc -p tsconfig.build.json --watch & tsc-alias -p tsconfig.build.json --resolve-full-paths -w",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "motion-script",
    "motion script",
    "math",
    "latex",
    "animation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Motionscript",
  "peerDependencies": {
    "@motionscript/sdk": "workspace:^"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.1",
    "@mathjax/src": "^4.1.1"
  },
  "devDependencies": {
    "@motionscript/core": "workspace:*",
    "@motionscript/sdk": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
