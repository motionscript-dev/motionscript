{
  "name": "@motionscript/patterns",
  "version": "0.1.0-alpha.7",
  "type": "module",
  "description": "Background patterns for Motion Script: line and dot grids that fill a box, and an infinite grid that fills whatever a camera can see.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motionscript-dev/motionscript.git",
    "directory": "packages/components/patterns"
  },
  "homepage": "https://motionscript.dev",
  "bugs": {
    "url": "https://github.com/motionscript-dev/motionscript/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "NOTICE",
    "dist",
    "src",
    "registry.json",
    "CHANGELOG.md",
    "!dist/**/*.tsbuildinfo",
    "!src/**/tests/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.fixtures.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && node ../../../scripts/build-browser.mjs",
    "dev": "tsc -p tsconfig.build.json --watch & tsc-alias -p tsconfig.build.json --resolve-full-paths -w",
    "clean": "rimraf --glob dist .turbo *.tsbuildinfo",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "motion-script",
    "motion script",
    "grid",
    "pattern",
    "background",
    "animation"
  ],
  "license": "Apache-2.0",
  "author": "Motionscript",
  "peerDependencies": {
    "@motionscript/sdk": "workspace:^"
  },
  "devDependencies": {
    "@motionscript/core": "workspace:*",
    "@motionscript/sdk": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
