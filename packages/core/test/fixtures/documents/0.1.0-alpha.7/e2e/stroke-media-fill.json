                  {
                    "type": "shader",
                    "source": "\nfn fill(in: FillIn) -> vec4f {\n    let p = vec2f((in.uv.x - 0.5) * in.size.x / in.size.y, in.uv.y - 0.5);\n    let a = 0.5 + 0.5 * sin(length(p) * 60.0);\n    let c = mix(vec3f(0.41, 0.56, 0.87), vec3f(0.91, 0.38, 0.49), a);\n    return vec4f(c * a, a);\n}",
