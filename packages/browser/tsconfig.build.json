{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Emit-only, so it lives here rather than in the base: `typecheck` runs
        // `--noEmit` over `src` *and* `test`, which have no common root but
        // need no output layout either.
        "rootDir": "src",
        // Co-locate buildinfo in dist/ so turbo caches it with the emitted
        // output (avoids stale-declaration bugs on cache restore).
        "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
    },
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.fixtures.ts",
        "src/**/tests",
        "test"
    ]
}
