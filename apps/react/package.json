{
  "name": "@motionscript/app-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Demo app: a Vite + React page that plays Motion Script scenes through MotionPlayer with hand-rolled controls.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@motionscript/core": "workspace:*",
    "@motionscript/sdk": "workspace:*",
    "@motionscript/react": "workspace:*",
    "@motionscript/shaders": "workspace:*",
    "@motionscript/browser": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
