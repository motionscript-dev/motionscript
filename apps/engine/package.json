{
  "name": "@motionscript/app-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Demo server: renders Motion Script scenes to PNG/MP4 in Node and serves them over HTTP.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@motionscript/sdk": "workspace:*",
    "@motionscript/core": "workspace:*",
    "@motionscript/headless": "workspace:*",
    "@motionscript/shaders": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
