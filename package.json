{
  "name": "@motionscript/root",
  "private": true,
  "version": "0.1.1-alpha.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "build:lib": "turbo run build --filter=\"!./apps/*\" --force",
    "check": "node scripts/check.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @motionscript/e2e test:e2e",
    "release": "node scripts/release.mjs",
    "promote": "node scripts/promote.mjs",
    "clean": "turbo run clean && rimraf .turbo"
  },
  "author": "Motionscript",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.0.9",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "concurrently": "^9.0.0",
    "esbuild": "0.28.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.14"
  }
}
